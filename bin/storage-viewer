#!/usr/bin/env python3
"""Launcher that works straight from a checkout, including through symlinks."""
import os
import sys

sys.dont_write_bytecode = True  # keep installed directories free of cache files

here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(here))

from storage_viewer.cli import main  # noqa: E402

raise SystemExit(main())
